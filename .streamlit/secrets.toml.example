# Copia este contenido en Streamlit Community Cloud › App settings › Secrets.
# Nunca subas un secrets.toml real al repositorio.

[periovision]
# Administrador inicial: se crea solo si aún no hay usuarios. Debe cambiar la clave al entrar.
admin_user = "admin"
admin_password = "Cambia-Esta-Clave-2026!"

# Pesos del modelo fuera del repositorio (custodia separada). La app los descarga una vez y
# los descarta si la huella SHA-256 no coincide.
model_url = "https://ejemplo.org/ruta/privada/best.pt"
model_sha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
